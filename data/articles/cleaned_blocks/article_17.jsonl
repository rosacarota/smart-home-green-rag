{"kind": "paragraph", "text": "Generating enough electricity to cook for an hour in a standard electric oven creates 2.7 pounds of CO 2. A toaster oven creates 1.3 pounds over 50 minutes; a microwave creates 0.5 pounds over 15 minutes.", "category": "main", "reason": "main_content", "level": 2, "section_path": ["Did you know?"], "source_tag": "p", "source_type": "", "coords": "7,84.00,79.58,415.07,16.74;7,84.00,103.58,259.22,16.74;7,343.20,108.84,6.95,13.95;7,350.15,103.58,158.37,16.74;7,84.00,131.33,409.27,16.74;7,84.00,155.33,110.89,16.74", "warnings": [], "article_id": "article_17", "source_title": "article_17", "source_tei": "data\\articles\\extracted_grobid_tei\\article_17.grobid.tei.xml", "block_index": 19, "section_title": "Did you know?", "section_depth": 1, "word_count": 39, "text_characters": 204, "pages": [7]}
{"kind": "paragraph", "text": "Today's dishwashers are about 95% more energy-efficient than those bought in 1972-your old dishwasher may be costing you more in energy bills than it would take to buy a new one.", "category": "main", "reason": "main_content", "level": 2, "section_path": ["Did you know?"], "source_tag": "p", "source_type": "", "coords": "7,84.00,186.83,417.72,16.74;7,84.00,210.83,421.79,16.74;7,84.00,234.83,373.41,16.74", "warnings": [], "article_id": "article_17", "source_title": "article_17", "source_tei": "data\\articles\\extracted_grobid_tei\\article_17.grobid.tei.xml", "block_index": 20, "section_title": "Did you know?", "section_depth": 1, "word_count": 34, "text_characters": 178, "pages": [7]}
