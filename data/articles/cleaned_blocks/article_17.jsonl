{"kind": "paragraph", "text": "You can save as much as 3,000 gallons of water per year by turning off the tap when you brush your teeth.", "category": "main", "reason": "main_content", "level": 2, "section_path": ["Down the drain"], "source_tag": "p", "source_type": "", "coords": "8,84.00,191.18,400.38,16.74;8,84.00,215.18,301.44,16.74;8,84.00,191.18,53.66,16.74;8,379.19,215.18,6.25,16.74", "warnings": [], "article_id": "article_17", "source_title": "article_17", "source_tei": "data\\articles\\extracted_grobid_tei\\article_17.grobid.tei.xml", "block_index": 26, "section_title": "Down the drain", "section_depth": 1, "word_count": 23, "text_characters": 105, "pages": [8]}
{"kind": "paragraph", "text": "A full bathtub requires between 40 gallons and 70 gallons of water; take a shower instead to save water and energy!", "category": "main", "reason": "main_content", "level": 2, "section_path": ["Down the drain"], "source_tag": "p", "source_type": "", "coords": "8,84.00,246.68,397.60,16.74;8,84.00,270.68,367.57,16.74;8,84.00,246.68,33.35,16.74", "warnings": [], "article_id": "article_17", "source_title": "article_17", "source_tei": "data\\articles\\extracted_grobid_tei\\article_17.grobid.tei.xml", "block_index": 27, "section_title": "Down the drain", "section_depth": 1, "word_count": 21, "text_characters": 115, "pages": [8]}
